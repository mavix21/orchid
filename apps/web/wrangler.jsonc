{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orchid",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://orchid:orchid-local@127.0.0.1:55432/orchid",
    },
  ],
  "compatibility_date": "2026-11-15",
  "main": "src/server.ts",
  "vars": { "STELLAR_RPC_URL": "https://soroban-testnet.stellar.org" },
  "secrets": { "required": ["RESERVE_SPONSOR_SECRET", "FEE_PAYER_SECRET"] },
  "triggers": { "crons": ["* * * * *"] },
  "observability": {
    "enabled": true,
  },
}
