{
  "name": "@workspace/wallet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.server.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run && bun ../../tools/wallet/check-boundary.mjs",
    "db:generate": "drizzle-kit generate",
    "testnet:prepare": "bun scripts/prepare-testnet.server.ts",
    "testnet:verify": "bun --env-file=.dev.vars scripts/testnet.server.ts"
  },
  "dependencies": {
    "@effect/sql-pg": "4.1.4",
    "@stellar/stellar-sdk": "17.4.0",
    "@workspace/db": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.4",
    "@types/bun": "1.4.4",
    "drizzle-kit": "1.0.0-rc.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
