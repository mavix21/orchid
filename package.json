{
  "name": "orchid",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "oxlint",
    "typecheck": "turbo typecheck",
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@effect/tsgo": "0.69.0",
    "@oxlint/plugins": "1.93.0",
    "@shadcn/lint": "^0.2.5",
    "oxfmt": "^0.78.0",
    "oxlint": "1.93.0",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.4"
}
